#pragma kernel AddParticles
#pragma kernel InterpolateVelocity
#pragma kernel RK4Update
#pragma kernel WrapPositions
#pragma kernel ClampPositionsToVolume
#pragma kernel PushParticlesOutOfSolidMask
#pragma kernel DisperseMazeParticles
#pragma kernel DriftMazeSourceParticles
#pragma kernel DriftMazeTowardVent
#pragma kernel DeflectMazeAtWallParticles

RWStructuredBuffer<float> _PosX;
RWStructuredBuffer<float> _PosY;
RWStructuredBuffer<float> _PosZ;

StructuredBuffer<float>   _NewX;
StructuredBuffer<float>   _NewY;
StructuredBuffer<float>   _NewZ;

StructuredBuffer<float>   _VelFieldX;
StructuredBuffer<float>   _VelFieldY;
StructuredBuffer<float>   _VelFieldZ;

StructuredBuffer<float>   _ShiftX;
StructuredBuffer<float>   _ShiftY;
StructuredBuffer<float>   _ShiftZ;

RWStructuredBuffer<float> _OutX;
RWStructuredBuffer<float> _OutY;
RWStructuredBuffer<float> _OutZ;

StructuredBuffer<float>   _K1X;
StructuredBuffer<float>   _K1Y;
StructuredBuffer<float>   _K1Z;
StructuredBuffer<float>   _K2X;
StructuredBuffer<float>   _K2Y;
StructuredBuffer<float>   _K2Z;
StructuredBuffer<float>   _K3X;
StructuredBuffer<float>   _K3Y;
StructuredBuffer<float>   _K3Z;
StructuredBuffer<float>   _K4X;
StructuredBuffer<float>   _K4Y;
StructuredBuffer<float>   _K4Z;

int   _ParticleCount;
int   _ParticleOffset;
float _DT;
float _ShiftFactor;

int   _TorResX;
int   _TorResY;
int   _TorResZ;
float _TorDX;
float _TorDY;
float _TorDZ;
// 1 — clamp индексы сетки (непериодичный домен); 0 — toroidal wrap (Jet, кольца).
int   _ClampSampling;

float _VolSizeX;
float _VolSizeY;
float _VolSizeZ;

StructuredBuffer<int> _SolidMask;
int _PushSearchCells;
float3 _VentTarget;
float _VentBiasWeight;

float _DisperseSigma;
float _DisperseWallBoost;
int _DisperseSeed;

float3 _SourceCenter;
float3 _SourceHalf;
float3 _SourceDriftV;
float _SourceDriftDT;

float3 _VentDriftTarget;
float _VentDriftStrength;
float _VentDriftDT;

float _DeflectStep;
int _DeflectSearchCells;

int CellIdxClamped(int raw, int res)
{
    return clamp(raw, 0, res - 1);
}

int CellIdxWrapped(int raw, int res)
{
    return ((raw % res) + res) % res;
}

int CellIdx(int raw, int res)
{
    return (_ClampSampling != 0) ? CellIdxClamped(raw, res) : CellIdxWrapped(raw, res);
}

int CellIdxPlus(int ix, int res)
{
    return (_ClampSampling != 0) ? min(ix + 1, res - 1) : ((ix + 1) % res);
}

int SolidAt(int ix, int iy, int iz)
{
    ix = clamp(ix, 0, _TorResX - 1);
    iy = clamp(iy, 0, _TorResY - 1);
    iz = clamp(iz, 0, _TorResZ - 1);
    int r2 = _TorResZ;
    int r21 = _TorResY * _TorResZ;
    return _SolidMask[ix * r21 + iy * r2 + iz];
}

float MazeHash01(uint n)
{
    n = (n ^ 61u) ^ (n >> 16);
    n *= 9u;
    n = n ^ (n >> 4);
    n *= 0x27d4eb2du;
    n = n ^ (n >> 15);
    return (float)(n & 0x00ffffffu) / (float)0x01000000u;
}

[numthreads(256, 1, 1)]
void AddParticles(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    _PosX[i + _ParticleOffset] = _NewX[i];
    _PosY[i + _ParticleOffset] = _NewY[i];
    _PosZ[i + _ParticleOffset] = _NewZ[i];
}

[numthreads(256, 1, 1)]
void InterpolateVelocity(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float sh_x = _ShiftX[i] * _ShiftFactor;
    float cell_x = (_PosX[i] + sh_x) / _TorDX;
    int ix_raw = (int)floor(cell_x);
    float wx = cell_x - (float)ix_raw;
    int ix  = CellIdx(ix_raw, _TorResX);
    int ixp = CellIdxPlus(ix, _TorResX);

    float sh_y = _ShiftY[i] * _ShiftFactor;
    float cell_y = (_PosY[i] + sh_y) / _TorDY;
    int iy_raw = (int)floor(cell_y);
    float wy = cell_y - (float)iy_raw;
    int iy  = CellIdx(iy_raw, _TorResY);
    int iyp = CellIdxPlus(iy, _TorResY);

    float sh_z = _ShiftZ[i] * _ShiftFactor;
    float cell_z = (_PosZ[i] + sh_z) / _TorDZ;
    int iz_raw = (int)floor(cell_z);
    float wz = cell_z - (float)iz_raw;
    int iz  = CellIdx(iz_raw, _TorResZ);
    int izp = CellIdxPlus(iz, _TorResZ);

    int r2 = _TorResZ;
    int r21 = _TorResZ * _TorResY;

    _OutX[i] = (1.0 - wz) * ((1.0 - wy) * _VelFieldX[ix * r21 + iy * r2 + iz]
                                     + wy * _VelFieldX[ix * r21 + iyp * r2 + iz])
                    + wz  * ((1.0 - wy) * _VelFieldX[ix * r21 + iy * r2 + izp]
                                     + wy * _VelFieldX[ix * r21 + iyp * r2 + izp]);

    _OutY[i] = (1.0 - wz) * ((1.0 - wx) * _VelFieldY[ix * r21 + iy * r2 + iz]
                                     + wx * _VelFieldY[ixp * r21 + iy * r2 + iz])
                    + wz  * ((1.0 - wx) * _VelFieldY[ix * r21 + iy * r2 + izp]
                                     + wx * _VelFieldY[ixp * r21 + iy * r2 + izp]);

    _OutZ[i] = (1.0 - wy) * ((1.0 - wx) * _VelFieldZ[ix * r21 + iy * r2 + iz]
                                     + wx * _VelFieldZ[ixp * r21 + iy * r2 + iz])
                    + wy  * ((1.0 - wx) * _VelFieldZ[ix * r21 + iyp * r2 + iz]
                                     + wx * _VelFieldZ[ixp * r21 + iyp * r2 + iz]);
}

[numthreads(256, 1, 1)]
void RK4Update(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    _PosX[i] += (_K1X[i] + 2.0 * _K2X[i] + 2.0 * _K3X[i] + _K4X[i]) * _DT / 6.0;
    _PosY[i] += (_K1Y[i] + 2.0 * _K2Y[i] + 2.0 * _K3Y[i] + _K4Y[i]) * _DT / 6.0;
    _PosZ[i] += (_K1Z[i] + 2.0 * _K2Z[i] + 2.0 * _K3Z[i] + _K4Z[i]) * _DT / 6.0;
}

[numthreads(256, 1, 1)]
void ClampPositionsToVolume(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;
    _PosX[i] = clamp(_PosX[i], 0.0, _VolSizeX);
    _PosY[i] = clamp(_PosY[i], 0.0, _VolSizeY);
    _PosZ[i] = clamp(_PosZ[i], 0.0, _VolSizeZ);
}

// Выталкивает трассеры из ячеек маски стен (_SolidMask==1) к ближайшей свободной ячейке.
[numthreads(256, 1, 1)]
void PushParticlesOutOfSolidMask(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float px = _PosX[i], py = _PosY[i], pz = _PosZ[i];
    int ix = clamp((int)floor(px / _TorDX), 0, _TorResX - 1);
    int iy = clamp((int)floor(py / _TorDY), 0, _TorResY - 1);
    int iz = clamp((int)floor(pz / _TorDZ), 0, _TorResZ - 1);
    if (SolidAt(ix, iy, iz) == 0) return;

    // Чистое анти-вклинивание: ближайшая свободная ячейка по кратчайшему расстоянию.
    // Без направленного bias и без джиттера — иначе трассеры собираются в линии у стен.
    float bestD = 1e20;
    float3 bestCand = float3(px, py, pz);
    for (int r = 1; r <= _PushSearchCells; r++)
    {
        for (int dz = -r; dz <= r; dz++)
        for (int dy = -r; dy <= r; dy++)
        for (int dx = -r; dx <= r; dx++)
        {
            if (abs(dx) != r && abs(dy) != r && abs(dz) != r) continue;
            if (SolidAt(ix + dx, iy + dy, iz + dz) != 0) continue;
            float wx = ((float)(ix + dx) + 0.5) * _TorDX;
            float wy = ((float)(iy + dy) + 0.5) * _TorDY;
            float wz = ((float)(iz + dz) + 0.5) * _TorDZ;
            float3 cand = float3(wx, wy, wz);
            float d = length(cand - float3(px, py, pz));
            if (d < bestD)
            {
                bestD = d;
                bestCand = cand;
            }
        }
        if (bestD < 1e19) break; // первая оболочка со свободной ячейкой — кратчайший выход
    }

    if (bestD < 1e19)
    {
        _PosX[i] = bestCand.x;
        _PosY[i] = bestCand.y;
        _PosZ[i] = bestCand.z;
    }
}

// Турбулентная дисперсия в XZ + усиление у стен; curl-компонента для «закручивания».
[numthreads(256, 1, 1)]
void DisperseMazeParticles(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float px = _PosX[i], py = _PosY[i], pz = _PosZ[i];
    int ix = clamp((int)floor(px / _TorDX), 0, _TorResX - 1);
    int iy = clamp((int)floor(py / _TorDY), 0, _TorResY - 1);
    int iz = clamp((int)floor(pz / _TorDZ), 0, _TorResZ - 1);

    float wallProx = 0.0;
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
        wallProx = max(wallProx, (float)SolidAt(ix + dx, iy + dy, iz + dz));
    float sigma = _DisperseSigma * (1.0 + _DisperseWallBoost * wallProx);

    uint seed = (uint)i * 2654435761u + (uint)_DisperseSeed * 40503u;
    float rx = MazeHash01(seed + 1u) * 2.0 - 1.0;
    float rz = MazeHash01(seed + 7u) * 2.0 - 1.0;
    float ry2 = MazeHash01(seed + 13u) * 2.0 - 1.0;
    // Псевдо-vortex: смешиваем случайный вектор с поворотом на 90°.
    float2 v = float2(rx, rz);
    float2 curl = float2(v.y, -v.x);
    float2 d = normalize(v + 0.65 * curl + 1e-4) * sigma * (0.7 + 0.3 * abs(ry2));
    _PosX[i] += d.x;
    _PosZ[i] += d.y;
}

// Дрейф трассеров в зоне источника: гарантирует выход дыма, даже если поле u у ψ слабое.
[numthreads(256, 1, 1)]
void DriftMazeSourceParticles(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float px = _PosX[i], py = _PosY[i], pz = _PosZ[i];
    if (px < _SourceCenter.x - _SourceHalf.x || px > _SourceCenter.x + _SourceHalf.x
        || py < _SourceCenter.y - _SourceHalf.y || py > _SourceCenter.y + _SourceHalf.y
        || pz < _SourceCenter.z - _SourceHalf.z || pz > _SourceCenter.z + _SourceHalf.z)
        return;

    _PosX[i] = px + _SourceDriftV.x * _SourceDriftDT;
    _PosY[i] = py + _SourceDriftV.y * _SourceDriftDT;
    _PosZ[i] = pz + _SourceDriftV.z * _SourceDriftDT;
}

// Мягкий продольный поток по лабиринту, wall-aware: не тащит через стены,
// а заранее уводит струю к ближайшему свободному проходу и добавляет coherent curl у границы.
[numthreads(256, 1, 1)]
void DriftMazeTowardVent(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float px = _PosX[i], py = _PosY[i], pz = _PosZ[i];
    int ix = clamp((int)floor(px / _TorDX), 0, _TorResX - 1);
    int iy = clamp((int)floor(py / _TorDY), 0, _TorResY - 1);
    int iz = clamp((int)floor(pz / _TorDZ), 0, _TorResZ - 1);

    float2 drift = float2(1.0, 0.0);

    // Градиент маски: нормаль от ближайшей стены. Нужен для boundary layer и анти-залипания.
    float solidL = (float)SolidAt(ix - 1, iy, iz);
    float solidR = (float)SolidAt(ix + 1, iy, iz);
    float solidD = (float)SolidAt(ix, iy, iz - 1);
    float solidU = (float)SolidAt(ix, iy, iz + 1);
    float2 away = float2(solidL - solidR, solidD - solidU);
    float wallProx = saturate(abs(away.x) + abs(away.y));
    if (wallProx > 1e-4)
    {
        float2 n = normalize(away + 1e-5);
        float2 tangent = float2(-n.y, n.x);

        // У вертикальных граней верх/низ дают разные знаки, так формируются устойчивые ролики у кромок.
        float edgeSign = (abs(away.y) > abs(away.x)) ? sign(away.y) : sign(pz - _VentDriftTarget.z);
        drift += n * (0.55 * wallProx);
        drift += tangent * (0.75 * wallProx * edgeSign);
    }

    // Обход включается только рядом с препятствием. Если начинать слишком рано,
    // поток искусственно расщепляется и оставляет пустой клин перед стеной.
    float bestScore = -1e20;
    int bestDz = 0;
    int firstBlockedLook = 0;
    int lookMax = min(12, _TorResX - 1 - ix);
    for (int look = 1; look <= lookMax; look++)
    {
        if (SolidAt(ix + look, iy, iz) != 0)
        {
            firstBlockedLook = look;
            break;
        }
    }

    float avoid = firstBlockedLook > 0
        ? saturate((7.0 - (float)firstBlockedLook) / 6.0)
        : 0.0;

    if (avoid > 0.0)
    {
        int laneLookMax = min(lookMax, max(firstBlockedLook + 2, 3));
        int scan = min(_PushSearchCells, _TorResZ / 2);
        for (int dz = -scan; dz <= scan; dz++)
        {
            int jz = iz + dz;
            if (jz < 1 || jz >= _TorResZ - 1) continue;
            bool laneFree = true;
            for (int look = 1; look <= laneLookMax; look++)
                laneFree = laneFree && (SolidAt(ix + look, iy, jz) == 0);
            if (!laneFree) continue;

            float side = abs((float)dz);
            float towardVentZ = -abs((((float)jz + 0.5) * _TorDZ) - _VentDriftTarget.z) * 0.15;
            float score = -side * 1.35 + towardVentZ;
            if (score > bestScore)
            {
                bestScore = score;
                bestDz = dz;
            }
        }
    }

    if (bestDz != 0)
    {
        float side = sign((float)bestDz);
        float laneStrength = saturate(1.0 - abs((float)bestDz) / max(1.0, (float)_PushSearchCells));
        drift.x *= lerp(1.0, 0.68, avoid);
        drift.y += side * avoid * (0.75 + 0.55 * laneStrength);

        // Рециркуляция перед препятствием: частицы не собираются в плоскую пробку, а образуют заворот.
        float2 vortexCenter = float2(((float)(ix + max(firstBlockedLook, 1)) + 0.5) * _TorDX,
            ((float)(iz + bestDz) + 0.5) * _TorDZ);
        float2 rel = float2(px, pz) - vortexCenter;
        float r2 = dot(rel, rel) + 0.02;
        float2 swirl = float2(-rel.y, rel.x) / r2;
        drift += swirl * (0.018 * side * avoid);
    }

    float ventGate = smoothstep(_VentDriftTarget.x - 1.2, _VentDriftTarget.x - 0.25, px);
    float zPull = clamp(_VentDriftTarget.z - pz, -0.8, 0.8) * 0.12 * ventGate;
    drift += float2(0.0, zPull);
    drift = normalize(drift + 1e-5);

    _PosX[i] = px + drift.x * _VentDriftStrength * _VentDriftDT;
    _PosZ[i] = pz + drift.y * _VentDriftStrength * _VentDriftDT;
}

// Перед стеной (+X занят): ищем открытый проём вверх/вниз и сдвигаем трассер к нему.
[numthreads(256, 1, 1)]
void DeflectMazeAtWallParticles(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float px = _PosX[i], py = _PosY[i], pz = _PosZ[i];
    int ix = clamp((int)floor(px / _TorDX), 0, _TorResX - 1);
    int iy = clamp((int)floor(py / _TorDY), 0, _TorResY - 1);
    int iz = clamp((int)floor(pz / _TorDZ), 0, _TorResZ - 1);
    if (SolidAt(ix, iy, iz) != 0) return;

    bool blockedAhead = (ix < _TorResX - 1) && (SolidAt(ix + 1, iy, iz) != 0);
    if (!blockedAhead) return;

    int bestDz = 0;
    float bestScore = -1e20;
    for (int dz = -_DeflectSearchCells; dz <= _DeflectSearchCells; dz++)
    {
        if (dz == 0) continue;
        int jz = iz + dz;
        if (jz < 0 || jz >= _TorResZ) continue;
        if (SolidAt(ix, iy, jz) != 0) continue;
        if (ix < _TorResX - 1 && SolidAt(ix + 1, iy, jz) != 0) continue;
        float score = -(float)abs(dz);
        if (jz > iz) score += 0.15;
        if (score > bestScore)
        {
            bestScore = score;
            bestDz = dz;
        }
    }
    if (bestDz == 0) return;

    float step = sign((float)bestDz) * min(_DeflectStep, abs((float)bestDz) * _TorDZ * 0.42);
    _PosZ[i] = pz + step;
}

[numthreads(256, 1, 1)]
void WrapPositions(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _ParticleCount) return;

    float x = fmod(_PosX[i], _VolSizeX);
    if (x < 0.0) x += _VolSizeX;
    _PosX[i] = x;

    float y = fmod(_PosY[i], _VolSizeY);
    if (y < 0.0) y += _VolSizeY;
    _PosY[i] = y;

    float z = fmod(_PosZ[i], _VolSizeZ);
    if (z < 0.0) z += _VolSizeZ;
    _PosZ[i] = z;
}
