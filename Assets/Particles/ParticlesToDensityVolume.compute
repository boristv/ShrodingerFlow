#pragma kernel ClearScratch
#pragma kernel SplatterParticles
#pragma kernel ScratchToDensity

RWStructuredBuffer<uint> DensityScratch;
RWTexture3D<float4> DensityOut;

StructuredBuffer<float3> ParticlePositions;

uint _ResX;
uint _ResY;
uint _ResZ;
uint _TotalVoxels;
uint _ParticleCount;

float3 _VolumeMinWorld;
float3 _VolumeSizeWorld;

float _SplatRadiusWorld;
uint _SplatWeightFixed;
float _ScratchDenom;

[numthreads(64, 1, 1)]
void ClearScratch(uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex)
{
    uint i = groupId.x * 64u + groupIndex;
    if (i >= _TotalVoxels)
        return;
    DensityScratch[i] = 0u;
}

[numthreads(256, 1, 1)]
void SplatterParticles(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount)
        return;

    float3 wp = ParticlePositions[id];
    float3 uvw = (wp - _VolumeMinWorld) / _VolumeSizeWorld;
    if (any(uvw < 0.0) || any(uvw > 1.0))
        return;

    float3 res = float3((float)_ResX, (float)_ResY, (float)_ResZ);
    float3 cellWorld = _VolumeSizeWorld / res;          // размер вокселя по миру (по осям)
    int3 center = (int3)round(uvw * res - 0.5);         // ближайший воксель (центр i при uvw=(i+0.5)/res)

    // Радиус сплата в МИРОВЫХ единицах → форма капли одинакова на всех сценах,
    // не зависит от анизотропии/разрешения сетки. Расстояние тоже в мире → изотропно.
    float radWorld = max(_SplatRadiusWorld, 1e-4);
    float inv2sig2 = 1.0 / (2.0 * (radWorld * 0.5) * (radWorld * 0.5)); // радиус ≈ 2σ
    int3 rad = clamp((int3)ceil(radWorld / cellWorld), int3(1, 1, 1), int3(4, 4, 4));

    for (int dz = -rad.z; dz <= rad.z; dz++)
    for (int dy = -rad.y; dy <= rad.y; dy++)
    for (int dx = -rad.x; dx <= rad.x; dx++)
    {
        int3 c = center + int3(dx, dy, dz);
        if (any(c < 0))
            continue;
        if (c.x >= (int)_ResX || c.y >= (int)_ResY || c.z >= (int)_ResZ)
            continue;

        float3 voxCenterWorld = _VolumeMinWorld + (float3(c) + 0.5) * cellWorld;
        float3 dWorld = wp - voxCenterWorld;
        float w = exp(-dot(dWorld, dWorld) * inv2sig2);
        uint add = (uint)(w * (float)_SplatWeightFixed + 0.5);
        if (add == 0u)
            continue;

        uint lin = (uint)c.x * _ResY * _ResZ + (uint)c.y * _ResZ + (uint)c.z;
        InterlockedAdd(DensityScratch[lin], add);
    }
}

[numthreads(8, 8, 8)]
void ScratchToDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ResX || id.y >= _ResY || id.z >= _ResZ)
        return;

    uint lin = id.x * _ResY * _ResZ + id.y * _ResZ + id.z;
    float v = saturate((float)DensityScratch[lin] / max(_ScratchDenom, 1.0));
    DensityOut[id] = float4(v, v, v, 1.0);
}
